# The transcribe app (transcriber/server.py) on port 8006. setup/install.sh installs it as
# /etc/systemd/system/take-transcriber.service.
[Unit]
Description=Transcribe app
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP@
Environment=PYTHONPATH=@APP@
ExecStart=@APP@/.venv/bin/python -m transcriber.server
# A little ahead of other work, so recording keeps up (arecord inherits it). The transcriptions it runs
# after a take go at nice 19 ([pipeline] in its config).
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
