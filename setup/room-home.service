# The control unit's home page (home/server.py) on port 80.
# setup/install.sh installs it as /etc/systemd/system/room-home.service.
[Unit]
Description=Home page
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP@
Environment=PYTHONPATH=@APP@
ExecStart=@APP@/.venv/bin/python -m home.server
# port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
