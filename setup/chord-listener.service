# The chord app (chords/server.py). setup/install.sh installs it as
# /etc/systemd/system/chord-listener.service.
[Unit]
Description=Chord listener
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP@
Environment=PYTHONPATH=@APP@
ExecStart=@APP@/.venv/bin/python -m chords.server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
