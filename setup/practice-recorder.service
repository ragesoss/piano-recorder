# The recorder service (slot 5 in docs/components.md). setup/install.sh
# installs it as /etc/systemd/system/practice-recorder.service.
[Unit]
Description=Practice recorder
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@APP@
Environment=PYTHONPATH=@APP@
ExecStart=@APP@/.venv/bin/python -m recorder.server
# A little ahead of other work, so recording keeps up (arecord inherits it).
Nice=-5
IOSchedulingClass=best-effort
IOSchedulingPriority=0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
