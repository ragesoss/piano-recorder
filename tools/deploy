#!/bin/sh
# Copy this tree to the control unit and run its installer.
#   tools/deploy [HOST]     HOST: an ssh host (default: practice)
set -eu
host=${1:-practice}
here=$(cd "$(dirname "$0")/.." && pwd)
rsync -a --delete \
    --exclude .venv --exclude __pycache__ --exclude .pytest_cache \
    --exclude '/takes*' --exclude '/backing*' --exclude '/exercise-takes*' --exclude '/exercises-dev' --exclude '/chord-checks*' --exclude '/transcribe-takes*' --exclude '/board-dev*' --exclude .git --exclude /local \
    "$here/" "$host:practice-recorder/"
ssh "$host" practice-recorder/setup/install.sh
