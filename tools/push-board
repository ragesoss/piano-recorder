#!/usr/bin/env python3
"""Put the board's cards on the control unit, for the board app (port 8007): the JSON that
dobro-transcription's board/board.py makes of its board/cards.toml.

    cd ~/play/dobro-transcription && python3 board/board.py json | ~/play/piano-recorder/tools/push-board
    tools/push-board CARDS.json [--host practice | --to board-dev]

The file goes to the board's data_dir (/etc/room-board.toml: ~/board-data) as cards.json, written as
cards.json.new and then renamed over it, so the app never reads half of one. The app reads it on the next
request: nothing restarts. The player's edits not yet brought in (changes.jsonl) stay, shown on top of it.

The goals ("goals", and each card's "goals") are checked when there are any; a board pushed without them is shown
as before they were added. So are the cards' numbers (each a whole number, no two cards the same) and the mark
"ready" (true or false) when given; a board pushed without them shows no numbers and offers no "Ready".
"""

import argparse
import json
import re
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from board.store import (EFFORT_CLAUDE, EFFORT_PLAYER, GOAL_COLORS, IMPORTANCE, NOTE_BY, STATUSES, WHO, WORK,  # noqa: E402
                         is_stage)

REMOTE = "cd practice-recorder && .venv/bin/python -m board.store"


DATE = re.compile(r"^\d{4}-\d\d-\d\d")


def check_goals(goals) -> tuple[set[str], list[str]]:
    """The goals' ids, names, colors (one of the ten), history (oldest first, each a stage from 1 to 10, dated) and
    notes (each with its text, by the player or Claude)."""
    if goals is None:
        return set(), []
    if not isinstance(goals, list):
        return set(), ['"goals" must be a list']
    problems, ids, colors = [], set(), {}
    for n, g in enumerate(goals):
        gid = g.get("id") if isinstance(g, dict) else None
        if not gid or not isinstance(gid, str):
            problems.append(f"goal {n + 1}: no id")
            continue
        if gid in ids:
            problems.append(f"goal {gid}: the id is used twice")
        ids.add(gid)
        if not g.get("name"):
            problems.append(f"goal {gid}: no name")
        if g.get("color") not in GOAL_COLORS:
            problems.append(f"goal {gid}: color {g.get('color')!r} (one of {', '.join(GOAL_COLORS)})")
        else:
            colors.setdefault(g["color"], []).append(gid)
        hist = g.get("history", [])
        if not isinstance(hist, list) or any(not isinstance(h, dict) for h in hist):
            problems.append(f"goal {gid}: history must be a list of entries")
            continue
        for h in hist:
            if not is_stage(h.get("stage")):
                problems.append(f"goal {gid}: stage {h.get('stage')!r} (a whole number from 1 to 10)")
            if not DATE.match(str(h.get("date") or "")):
                problems.append(f"goal {gid}: a history entry with no date")
        dates = [str(h.get("date"))[:10] for h in hist]
        if dates != sorted(dates):
            problems.append(f"goal {gid}: the history is not oldest first")
        notes = g.get("notes", [])
        if not isinstance(notes, list) or any(not isinstance(n, dict) or not n.get("text") for n in notes):
            problems.append(f"goal {gid}: notes must be a list of entries, each with its text")
        elif any(n.get("by") not in NOTE_BY for n in notes):
            problems.append(f"goal {gid}: a note's by must be one of {', '.join(NOTE_BY)}")
        for k in ("about", "release", "shipped"):
            if not isinstance(g.get(k, ""), str):
                problems.append(f"goal {gid}: {k} must be text")
    for color, which in colors.items():
        if len(which) > 1:  # allowed (each is named wherever it is shown), but the colors no longer tell them apart
            print(f"warning: goals {', '.join(which)} share the color {color}", file=sys.stderr)
    return ids, problems


def check(raw) -> tuple[int, int]:
    """The contract's essentials (version 1, areas, each card's id and fields, the goals if any); exits with what
    is wrong."""
    problems = []
    if not isinstance(raw, dict) or raw.get("version") != 1:
        sys.exit('not a board: no "version": 1')
    areas, cards = raw.get("areas"), raw.get("cards")
    if not isinstance(areas, list) or not isinstance(cards, list):
        sys.exit('not a board: "areas" and "cards" must be lists')
    area_ids = {a.get("id") for a in areas if isinstance(a, dict)}
    if None in area_ids or len(area_ids) != len(areas):
        problems.append("every area needs its own id")
    goal_ids, goal_problems = check_goals(raw.get("goals"))
    problems += goal_problems
    st = raw.get("stages")
    if st is not None and (not isinstance(st, list) or len(st) != 10 or any(not isinstance(x, str) or not x.strip() for x in st)):
        problems.append('"stages" must be the ten stages\' labels, in order')
    seen, numbers = set(), {}
    for n, c in enumerate(cards):
        cid = c.get("id") if isinstance(c, dict) else None
        name = cid or f"card {n + 1}"
        if not cid or not isinstance(cid, str):
            problems.append(f"{name}: no id")
            continue
        if cid in seen:
            problems.append(f"{cid}: the id is used twice")
        seen.add(cid)
        if not c.get("title"):
            problems.append(f"{cid}: no title")
        if c.get("status") not in STATUSES:
            problems.append(f"{cid}: status {c.get('status')!r} (one of {', '.join(STATUSES)})")
        if c.get("work") not in WORK:
            problems.append(f"{cid}: work {c.get('work')!r} (one of {', '.join(WORK)})")
        if c.get("importance") not in IMPORTANCE or isinstance(c.get("importance"), bool):
            problems.append(f"{cid}: importance {c.get('importance')!r} (1, 2 or 3)")
        if not isinstance(c.get("who"), list) or not c["who"] or any(w not in WHO for w in c["who"]):
            problems.append(f"{cid}: who {c.get('who')!r} (one or more of {', '.join(WHO)})")
        if c.get("area") not in area_ids:
            problems.append(f"{cid}: area {c.get('area')!r} is not among the areas")
        if c.get("effort_player", "") not in EFFORT_PLAYER or c.get("effort_claude", "") not in EFFORT_CLAUDE:
            problems.append(f"{cid}: an effort the contract does not have")
        goals = c.get("goals", [])
        if not isinstance(goals, list) or len(set(map(str, goals))) != len(goals):
            problems.append(f"{cid}: goals {goals!r} (a list of goal ids, each once)")
        elif any(g not in goal_ids for g in goals):
            problems.append(f"{cid}: goals {', '.join(str(g) for g in goals if g not in goal_ids)} not among the goals")
        num = c.get("number")  # what the player says ("card 42"): absent or null before board.py gives one
        if num is not None:
            if not isinstance(num, int) or isinstance(num, bool) or num < 1:
                problems.append(f"{cid}: number {num!r} (a whole number from 1)")
            elif num in numbers:
                problems.append(f"{cid}: number {num} is {numbers[num]}'s too")
            else:
                numbers[num] = cid
        if "ready" in c and not isinstance(c["ready"], bool):
            problems.append(f"{cid}: ready {c['ready']!r} (true or false)")
    if problems:
        more = f"\n  ... and {len(problems) - 12} more" if len(problems) > 12 else ""
        sys.exit("the cards are not as the board reads them:\n  " + "\n  ".join(problems[:12]) + more)
    return len(cards), len(areas)


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("file", nargs="?", type=Path, help="default: read standard input")
    ap.add_argument("--host", default="practice", help="the control unit's ssh host")
    ap.add_argument("--to", type=Path, help="put it in this local data folder instead (development, tests)")
    a = ap.parse_args()
    text = a.file.read_text() if a.file else sys.stdin.read()
    try:
        raw = json.loads(text)
    except ValueError as e:
        sys.exit(f"not JSON: {e}")
    n, n_areas = check(raw)
    n_goals = len(raw.get("goals") or [])
    goals = f", {n_goals} goal{'s' if n_goals != 1 else ''}" if n_goals else ""
    body = json.dumps(raw, indent=1, ensure_ascii=False) + "\n"
    if a.to:
        a.to.mkdir(parents=True, exist_ok=True)
        tmp = a.to / "cards.json.new"
        tmp.write_text(body)
        tmp.replace(a.to / "cards.json")
        print(f"{n} cards in {n_areas} areas{goals}: in {a.to}")
        return
    where = subprocess.run(["ssh", a.host, f"{REMOTE} datadir"], capture_output=True, text=True)
    if where.returncode or not where.stdout.strip():
        sys.exit(f"the board is not set up on {a.host} (/etc/room-board.toml): {where.stderr.strip()[-300:]}")
    d = shlex.quote(where.stdout.strip())
    put = subprocess.run(["ssh", a.host, f"mkdir -p {d} && cat > {d}/cards.json.new && mv {d}/cards.json.new {d}/cards.json"],
                         input=body, text=True, capture_output=True)
    if put.returncode:
        sys.exit(f"not put on {a.host}: {put.stderr.strip()[-300:]}")
    print(f"{n} cards in {n_areas} areas{goals}: on {a.host} in {where.stdout.strip()}")


if __name__ == "__main__":
    main()
